---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  problems: string[];
  brands: string[];
  faqs: { q: string; a: string }[];
  waText: string;
  ctaTitle: string;
  related: { href: string; label: string }[];
}

const { title, description, h1, intro, problems, brands, faqs, waText, ctaTitle, related } = Astro.props;

const phone = '+971556710085';
const whatsapp = '971556710085';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h1 class="text-4xl font-extrabold md:text-5xl">{h1}</h1>
      <p class="mt-4 text-lg text-slate-300">{intro}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={`tel:${phone}`}
          class="rounded-lg bg-amber-400 px-7 py-3 font-bold text-slate-900 hover:bg-amber-300"
        >
          Call Now
        </a>
        <a
          href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(waText)}`}
          target="_blank"
          rel="noopener"
          class="rounded-lg bg-green-500 px-7 py-3 font-bold text-white hover:bg-green-600"
        >
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-extrabold">Common Problems We Fix</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {problems.map((p) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm font-medium">{p}</div>
      ))}
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="text-3xl font-extrabold">Brands We Repair</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {brands.map((b) => (
          <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <h2 class="text-center text-3xl font-extrabold">Why Call SM Home Repair</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      <li class="rounded-2xl bg-white p-5 shadow-sm">Same-day service across Dubai</li>
      <li class="rounded-2xl bg-white p-5 shadow-sm">Experienced, professional technicians</li>
      <li class="rounded-2xl bg-white p-5 shadow-sm">Free quote before work starts</li>
      <li class="rounded-2xl bg-white p-5 shadow-sm">Guaranteed repairs</li>
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-center text-3xl font-extrabold">Frequently Asked Questions</h2>
    <div class="mt-8 space-y-4">
      {faqs.map((f) => (
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-2 text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="text-2xl font-extrabold">Our Other Services</h2>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {related.map((r) => (
          <a
            href={r.href}
            class="rounded-full border border-slate-300 px-5 py-2 text-sm font-semibold hover:border-amber-400 hover:text-amber-600"
          >
            {r.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-900 py-14 text-center text-white">
    <h2 class="text-3xl font-extrabold">{ctaTitle}</h2>
    <p class="mt-2 text-slate-300">Call or WhatsApp us for a free quote today.</p>
    <a
      href={`tel:${phone}`}
      class="mt-6 inline-block rounded-lg bg-amber-400 px-8 py-3 font-bold text-slate-900 hover:bg-amber-300"
    >
      Call Now
    </a>
  </section>
</Layout>