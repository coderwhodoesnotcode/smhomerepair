---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const phone = '+971556710085';
const whatsapp = '971556710085';
const canonical = new URL(Astro.url.pathname, 'https://smhomerepair.com').href;
const ogImage = 'https://smhomerepair.com/og-image.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'SM Home Repair',
  url: 'https://smhomerepair.com',
  telephone: phone,
  areaServed: 'Dubai',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dubai',
    addressCountry: 'AE',
  },
  openingHours: 'Mo-Su 00:00-23:59',
  description,
};

const services = [
  { href: '/fridge-repair-dubai', label: 'Fridge Repair' },
  { href: '/washing-machine-repair-dubai', label: 'Washing Machine Repair' },
  { href: '/cooking-range-repair-dubai', label: 'Cooking Range Repair' },
  { href: '/washer-dryer-repair-dubai', label: 'Washer Dryer Repair' },
  { href: '/electrical', label: 'Electrical Services' },
  { href: '/handyman', label: 'Handyman Services' },
];

const mobileNav = [
  { href: '/', label: 'Home' },
  ...services,
  { href: '/areas', label: 'Areas' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SM Home Repair" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SM Home Repair - Fridge, Washing Machine, Cooking Range, Washer Dryer, Electrical and Handyman in Dubai" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-extrabold text-slate-900">
          SM <span class="text-amber-500">Home Repair</span>
        </a>
        <nav class="hidden items-center gap-6 md:flex">
          <a href="/" class="font-medium text-slate-600 hover:text-amber-600">Home</a>
          <div class="group relative">
            <button type="button" class="font-medium text-slate-600 hover:text-amber-600">Services ▾</button>
            <div class="absolute left-0 top-full hidden pt-2 group-hover:block">
              <div class="w-64 rounded-xl border border-slate-200 bg-white py-2 shadow-lg">
                {services.map((s) => (
                  <a href={s.href} class="block px-4 py-2 text-sm text-slate-700 hover:bg-amber-50 hover:text-amber-700">{s.label}</a>
                ))}
              </div>
            </div>
          </div>
          <a href="/areas" class="font-medium text-slate-600 hover:text-amber-600">Areas</a>
          <a href="/contact" class="font-medium text-slate-600 hover:text-amber-600">Contact</a>
        </nav>
        <a
          href={`tel:${phone}`}
          class="rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-slate-900 hover:bg-amber-300"
        >
          Call Now
        </a>
      </div>
      <nav class="flex gap-4 overflow-x-auto border-t border-slate-100 px-4 py-2 md:hidden">
        {mobileNav.map((item) => (
          <a href={item.href} class="whitespace-nowrap text-sm font-medium text-slate-600">{item.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="mt-16 bg-slate-950 py-10 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-3">
        <div>
          <h3 class="text-lg font-bold text-white">
            SM <span class="text-amber-400">Home Repair</span>
          </h3>
          <p class="mt-2 text-sm">Fridge, washing machine, cooking range, washer dryer, electrical and handyman services across Dubai.</p>
        </div>
        <div>
          <h3 class="font-bold text-white">Services</h3>
          <ul class="mt-2 space-y-1 text-sm">
            {services.map((s) => (
              <li><a href={s.href} class="hover:text-amber-400">{s.label}</a></li>
            ))}
            <li><a href="/areas" class="hover:text-amber-400">Areas We Serve</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-white">Contact</h3>
          <p class="mt-2 text-sm">Phone: <a href={`tel:${phone}`} class="hover:text-amber-400">{phone}</a></p>
          <p class="text-sm">Dubai, UAE</p>
        </div>
      </div>
      <p class="mt-8 text-center text-xs text-slate-500">
        © {new Date().getFullYear()} SM Home Repair. All rights reserved.
      </p>
    </footer>

    <a
      href={`https://wa.me/${whatsapp}?text=Hello%20SM%20Home%20Repair%2C%20I%20need%20a%20service`}
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
      class="fixed bottom-5 right-5 z-50 rounded-full bg-green-500 px-5 py-3 font-semibold text-white shadow-lg hover:bg-green-600"
    >
      WhatsApp
    </a>
  </body>
</html>