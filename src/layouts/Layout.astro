---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const phone = '+971556710085';
const whatsapp = '971556710085';
const canonical = new URL(Astro.url.pathname, 'https://smhomerepair.com').href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'SM Home Repair',
  url: 'https://smhomerepair.com',
  telephone: phone,
  areaServed: 'Dubai',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dubai',
    addressCountry: 'AE',
  },
  openingHours: 'Mo-Su 00:00-23:59',
  description,
};

const nav = [
  { href: '/', label: 'Home' },
  { href: '/plumbing', label: 'Plumbing' },
  { href: '/electrical', label: 'Electrical' },
  { href: '/handyman', label: 'Handyman' },
  { href: '/areas', label: 'Areas' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-extrabold text-slate-900">
          SM <span class="text-amber-500">Home Repair</span>
        </a>
        <nav class="hidden gap-6 md:flex">
          {nav.map((item) => (
            <a href={item.href} class="font-medium text-slate-600 hover:text-amber-600">{item.label}</a>
          ))}
        </nav>
        <a
          href={`tel:${phone}`}
          class="rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-slate-900 hover:bg-amber-300"
        >
          Call Now
        </a>
      </div>
      <nav class="flex gap-4 overflow-x-auto border-t border-slate-100 px-4 py-2 md:hidden">
        {nav.map((item) => (
          <a href={item.href} class="whitespace-nowrap text-sm font-medium text-slate-600">{item.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="mt-16 bg-slate-950 py-10 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-3">
        <div>
          <h3 class="text-lg font-bold text-white">
            SM <span class="text-amber-400">Home Repair</span>
          </h3>
          <p class="mt-2 text-sm">Trusted plumbing, electrical and handyman services across Dubai.</p>
        </div>
        <div>
          <h3 class="font-bold text-white">Services</h3>
          <ul class="mt-2 space-y-1 text-sm">
            <li><a href="/plumbing" class="hover:text-amber-400">Plumbing</a></li>
            <li><a href="/electrical" class="hover:text-amber-400">Electrical</a></li>
            <li><a href="/handyman" class="hover:text-amber-400">Handyman</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-white">Contact</h3>
          <p class="mt-2 text-sm">Phone: <a href={`tel:${phone}`} class="hover:text-amber-400">{phone}</a></p>
          <p class="text-sm">Dubai, UAE</p>
        </div>
      </div>
      <p class="mt-8 text-center text-xs text-slate-500">
        © {new Date().getFullYear()} SM Home Repair. All rights reserved.
      </p>
    </footer>

    <a
      href={`https://wa.me/${whatsapp}?text=Hello%20SM%20Home%20Repair%2C%20I%20need%20a%20service`}
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
      class="fixed bottom-5 right-5 z-50 rounded-full bg-green-500 px-5 py-3 font-semibold text-white shadow-lg hover:bg-green-600"
    >
      WhatsApp
    </a>
  </body>
</html>