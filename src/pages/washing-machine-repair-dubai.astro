const faqs = [
  {
    q: 'Do you provide same-day washing machine repair in Dubai?',
    a: 'Yes. Call or WhatsApp us and we will send a technician as soon as possible.',
  },
  {
    q: 'Why is my washing machine not draining?',
    a: 'Common causes are a blocked drain pump, a clogged filter or a blocked drain hose. Our technician checks and fixes the exact fault.',
  },
  {
    q: 'Do you repair both front-load and top-load washing machines?',
    a: 'Yes. We repair front-load and top-load washing machines, automatic and semi-automatic.',
  },
  {
    q: 'How much does washing machine repair cost in Dubai?',
    a: 'The price depends on the fault. We give you a free quote before we start work.',
  },
