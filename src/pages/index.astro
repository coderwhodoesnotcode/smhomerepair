---
import Layout from '../layouts/Layout.astro';

const phone = '+971556710085';
const whatsapp = '971556710085';

const services = [
  {
    title: 'Fridge Repair',
    href: '/fridge-repair-dubai',
    text: 'Not cooling, leaking, ice build-up and gas refill for all fridge brands.',
  },
  {
    title: 'Washing Machine Repair',
    href: '/washing-machine-repair-dubai',
    text: 'Not draining, not spinning, leaking and error codes fixed fast.',
  },
  {
    title: 'Cooking Range Repair',
    href: '/cooking-range-repair-dubai',
    text: 'Gas and electric cooking ranges, burners, ovens and ignition faults.',
  },
  {
    title: 'Washer Dryer Repair',
    href: '/washer-dryer-repair-dubai',
    text: 'Washer dryers and dryers that do not dry, heat or drain.',
  },
  {
    title: 'Electrical Services',
    href: '/electrical',
    text: 'Wiring, sockets, switches, lighting, DB panels and fault finding.',
  },
  {
    title: 'Handyman Services',
    href: '/handyman',
    text: 'Furniture assembly, painting, door and lock repair, TV mounting and more.',
  },
];

const reasons = [
  { title: 'Same-Day Service', text: 'Fast response across Dubai, including urgent calls.' },
  { title: 'Skilled Technicians', text: 'Experienced and professional technicians for every job.' },
  { title: 'Clear Pricing', text: 'Free quote before we start. No hidden charges.' },
  { title: 'Work Guarantee', text: 'We stand behind every repair we do.' },
];

const steps = [
  { n: '1', title: 'Call or WhatsApp', text: 'Tell us what you need.' },
  { n: '2', title: 'Get a Quote', text: 'We confirm the price and time.' },
  { n: '3', title: 'Problem Solved', text: 'Our technician fixes it on site.' },
];

const areas = [
  'Dubai Marina', 'JLT', 'Downtown Dubai', 'Business Bay', 'Jumeirah',
  'Deira', 'Bur Dubai', 'Al Barsha', 'JVC', 'Dubai Hills',
];

const faqs = [
  {
    q: 'Do you offer same-day service in Dubai?',
    a: 'Yes. Call or WhatsApp us and we will send a technician as soon as possible.',
  },
  {
    q: 'What do you repair?',
    a: 'We repair fridges, washing machines, cooking ranges and washer dryers. We also offer electrical and handyman services.',
  },
  {
    q: 'How much does repair cost in Dubai?',
    a: 'It depends on the job. We give you a free quote before starting any work.',
  },
  {
    q: 'Which areas do you cover?',
    a: 'We cover all major areas of Dubai. See our Areas page for the full list.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Fridge, Washing Machine, Dryer & Cooking Range Repair Dubai | SM Home Repair"
  description="Fridge repair, washing machine repair, washer dryer repair and cooking range repair in Dubai, plus electrical and handyman services. Same-day service, free quote."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 py-24 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <p class="mb-4 inline-block rounded-full border border-amber-400/40 px-4 py-1 text-sm font-medium text-amber-300">
        Serving all of Dubai
      </p>
      <h1 class="text-4xl font-extrabold md:text-5xl">
        Fridge, Washing Machine, Dryer & Cooking Range Repair in <span class="text-amber-400">Dubai</span>
      </h1>
      <p class="mt-5 text-lg text-slate-300">
        Fast, reliable repair at your home. Same-day service and free quotes. Electrical and handyman work too.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={`tel:${phone}`}
          class="rounded-lg bg-amber-400 px-7 py-3 font-bold text-slate-900 hover:bg-amber-300"
        >
          Call Now
        </a>
        <a
          href={`https://wa.me/${whatsapp}?text=Hello%2C%20I%20need%20a%20service`}
          target="_blank"
          rel="noopener"
          class="rounded-lg bg-green-500 px-7 py-3 font-bold text-white hover:bg-green-600"
        >
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-extrabold">Our Services</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a
          href={s.href}
          class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg"
        >
          <h3 class="text-xl font-bold text-slate-900">{s.title}</h3>
          <p class="mt-2 text-slate-600">{s.text}</p>
          <span class="mt-4 inline-block font-semibold text-amber-600">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center text-3xl font-extrabold">Why Choose SM Home Repair</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r) => (
          <div class="rounded-2xl bg-slate-50 p-6 text-center">
            <h3 class="font-bold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-extrabold">How It Works</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-400 text-xl font-extrabold text-slate-900">
            {s.n}
          </div>
          <h3 class="mt-4 font-bold">{s.title}</h3>
          <p class="mt-1 text-slate-600">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Areas -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h2 class="text-3xl font-extrabold">Areas We Serve in Dubai</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {areas.map((a) => (
          <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800">{a}</span>
        ))}
      </div>
      <a href="/areas" class="mt-8 inline-block font-semibold text-amber-600">See all areas →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-center text-3xl font-extrabold">Frequently Asked Questions</h2>
    <div class="mt-8 space-y-4">
      {faqs.map((f) => (
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-2 text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-900 py-14 text-center text-white">
    <h2 class="text-3xl font-extrabold">Need a Repair Today?</h2>
    <p class="mt-2 text-slate-300">Call or WhatsApp us for a free quote.</p>
    <a
      href={`tel:${phone}`}
      class="mt-6 inline-block rounded-lg bg-amber-400 px-8 py-3 font-bold text-slate-900 hover:bg-amber-300"
    >
      Call Now
    </a>
  </section>
</Layout>