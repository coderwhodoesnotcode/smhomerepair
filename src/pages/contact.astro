---
import Layout from '../layouts/Layout.astro';

const phone = '+971556710085';
const whatsapp = '971556710085';
---

<Layout
  title="Contact SM Home Repair | Call or WhatsApp in Dubai"
  description="Contact SM Home Repair in Dubai for plumbing, electrical and handyman services. Call or WhatsApp for a free quote."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h1 class="text-4xl font-extrabold md:text-5xl">
        Contact <span class="text-amber-400">Us</span>
      </h1>
      <p class="mt-4 text-lg text-slate-300">
        Call, WhatsApp or send a request. We reply fast.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2">
    <!-- Contact info -->
    <div>
      <h2 class="text-3xl font-extrabold">Get a Free Quote</h2>
      <p class="mt-3 text-slate-600">
        Tell us what you need and we will confirm the price and time before we start.
      </p>

      <div class="mt-8 space-y-4">
        <a
          href={`tel:${phone}`}
          class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-amber-400"
        >
          <p class="text-sm text-slate-500">Call us</p>
          <p class="text-xl font-bold">{phone}</p>
        </a>
        <a
          href={`https://wa.me/${whatsapp}?text=Hello%2C%20I%20need%20a%20service`}
          target="_blank"
          rel="noopener"
          class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-green-500"
        >
          <p class="text-sm text-slate-500">WhatsApp</p>
          <p class="text-xl font-bold">Chat with us now</p>
        </a>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm text-slate-500">Service area</p>
          <p class="text-xl font-bold">All of Dubai, UAE</p>
        </div>
      </div>
    </div>

    <!-- Request form -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-extrabold">Send a Request</h2>
      <div id="request-form" class="mt-6 space-y-4">
        <div>
          <label for="name" class="block text-sm font-semibold">Your name</label>
          <input
            id="name"
            type="text"
            class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div>
          <label for="service" class="block text-sm font-semibold">Service needed</label>
          <select
            id="service"
            class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-amber-400 focus:outline-none"
          >
            <option>Plumbing</option>
            <option>Electrical</option>
            <option>Handyman</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="area" class="block text-sm font-semibold">Your area in Dubai</label>
          <input
            id="area"
            type="text"
            placeholder="Example: Dubai Marina"
            class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-amber-400 focus:outline-none"
          />
        </div>
        <div>
          <label for="details" class="block text-sm font-semibold">Problem details</label>
          <textarea
            id="details"
            rows="4"
            class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-amber-400 focus:outline-none"
          ></textarea>
        </div>
        <button
          id="send-btn"
          type="button"
          class="w-full rounded-lg bg-green-500 px-6 py-3 font-bold text-white hover:bg-green-600"
        >
          Send on WhatsApp
        </button>
      </div>
    </div>
  </section>

  <script define:vars={{ whatsapp }}>
    document.getElementById('send-btn').addEventListener('click', () => {
      const name = document.getElementById('name').value.trim();
      const service = document.getElementById('service').value;
      const area = document.getElementById('area').value.trim();
      const details = document.getElementById('details').value.trim();

      const message =
        'Hello SM Home Repair,\n' +
        'Name: ' + name + '\n' +
        'Service: ' + service + '\n' +
        'Area: ' + area + '\n' +
        'Details: ' + details;

      window.open('https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(message), '_blank');
    });
  </script>
</Layout>