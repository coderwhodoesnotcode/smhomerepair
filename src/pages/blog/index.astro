---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Home Repair Blog | SM Home Repair Dubai"
  description="Helpful guides on fridge, washing machine, cooking range and washer dryer repair in Dubai from SM Home Repair."
>
  <Breadcrumbs items={[{ label: 'Blog' }]} />
  <main class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-extrabold text-slate-900 md:text-4xl">
      Home Repair <span class="text-amber-500">Blog</span>
    </h1>
    <p class="mt-2 text-slate-600">Practical guides and repair tips from SM Home Repair, Dubai.</p>

    <div class="mt-8 grid gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-amber-400 hover:shadow-md"
        >
          <p class="text-xs font-medium text-slate-500">{formatDate(post.data.pubDate)}</p>
          <h2 class="mt-1 text-xl font-bold text-slate-900">{post.data.title}</h2>
          <p class="mt-2 text-slate-600">{post.data.description}</p>
          <span class="mt-3 inline-block text-sm font-bold text-amber-600">Read more →</span>
        </a>
      ))}
    </div>
  </main>
</Layout>